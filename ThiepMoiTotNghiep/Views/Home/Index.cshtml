@{
    ViewData["Title"] = "Thiệp Mời Tốt Nghiệp - Lễ Quốc Huy";
}

@section Styles {
    <style>
        :root {
            --primary-color: #A67C52;
            --accent-color: #E89528;
            --bg-color: #FFFDF1;
            --card-bg: #FFFFFF;
            --text-color: #333333;
            --info-label-color: #8C8C8C;
        }
    </style>
}

<video id="bg-video-laptop" autoplay muted loop playsinline>
    <source src="~/Video/Ngang_LapTop.mp4" type="video/mp4">
</video>

<video id="bg-video-mobile" autoplay muted loop playsinline>
    <source src="~/Video/Doc_Mobile.mp4" type="video/mp4">
</video>

<button id="chat-btn" title="Chat với chúng tôi" onclick="toggleChat()">
    <i class="bi bi-chat-dots-fill" id="chat-icon"></i>
</button>

<!-- Popup chat -->
<div id="chat-popup" style="display:none;">
    <div id="chat-header">
        <span>Cộng đồng bạn của <b>Quốc Huy</b></span>
        <button onclick="toggleChat()" title="Thu nhỏ">－</button>
    </div>

    <div id="chat-messages">
        <!-- Lịch sử chat sẽ được load bằng JS -->
    </div>

    <div id="reply-banner">
        <div class="reply-banner-body">
            <span>Đang trả lời </span><span id="reply-banner-name"></span>:
            <span id="reply-banner-text"></span>
        </div>
        <button id="reply-cancel-btn" onclick="cancelReply()" title="Hủy trả lời">✕</button>
    </div>

    <div id="chat-input-area">
        <input type="text" id="chat-input" placeholder="Aa" onkeydown="sendMsg(event)" maxlength="500">
        <button id="chat-send-btn" onclick="sendMsg()"><i class="bi bi-send-fill"></i></button>
    </div>
</div>

<button id="music-btn" title="Bật/Tắt nhạc nền" onclick="toggleMusic()">
    <i class="bi bi-music-note-beamed" id="music-icon"></i>
</button>

<audio id="bg-music" loop>
    <source src="~/Video/NhacNen.mp3" type="audio/mpeg">
</audio>

