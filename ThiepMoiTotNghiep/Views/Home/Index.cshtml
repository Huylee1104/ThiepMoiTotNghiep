<div class="modal fade" id="nameModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="nameModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="nameModalLabel">Nhập Tên Khách Mời</h5>
            </div>
            <div class="modal-body">
                <div class="text-center mb-1">Vui lòng nhập chính xác họ và tên giúp mình nhé!</div>
                <input type="text" id="guestNameInput" class="form-control" placeholder="Ví dụ: Lê Quốc Huy" />
                <div id="nameError" class="text-danger mt-2" style="display: none;">Vui lòng nhập tên!</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="submitName()">Xác Nhận</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="attendanceModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="attendanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="attendanceModalLabel">Xác Nhận Tham Gia</h5>
            </div>
            <div class="modal-body">
                Bạn có tham gia lễ tốt nghiệp cùng chúng tôi không?
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-success" onclick="submitAttendance(true)">Có, tôi sẽ tham gia</button>
                <button type="button" class="btn btn-secondary" onclick="submitAttendance(false)">Không, tôi bận</button>
            </div>
        </div>
    </div>
</div>

<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                Hãy bấm in thiệp ở bên dưới!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<div id="albumModal" role="dialog" aria-modal="true" aria-label="Album tốt nghiệp">

    <!-- Header: tiêu đề + số trang + nút đóng -->
    <header id="albumHeader">
        <h2 id="albumTitle">✦ Album Tốt Nghiệp</h2>
        <span id="albumPageInfo">Trang 1</span>
        <button id="btnCloseAlbum" aria-label="Đóng album" title="Đóng">
            <i class="bi bi-x-lg"></i>
        </button>
    </header>

    <!-- Wrapper chứa flipbook + nút nav -->
    <div id="albumWrapper">
        <!-- Nút lật trang trước -->
        <button class="album-nav-btn" id="btnPrev" aria-label="Trang trước" title="Trang trước">
            <i class="bi bi-chevron-left"></i>
        </button>

        <!-- Container StPageFlip sẽ render vào đây -->
        <div id="flipbookContainer">
            <!-- Loading spinner -->
            <div id="albumLoading">
                <div class="spinner-ring"></div>
                <span class="loading-text">Đang mở album…</span>
            </div>
            <!-- Các trang .album-page được inject bởi JS -->
        </div>

        <!-- Nút lật trang sau -->
        <button class="album-nav-btn" id="btnNext" aria-label="Trang tiếp" title="Trang tiếp">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>

    <!-- Footer: dot navigator -->
    <footer id="albumFooter"></footer>

</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let currentGuestId = 0;
        let currentGuestName = "";
        let nameModal;
        let attendanceModal;
    </script>
}