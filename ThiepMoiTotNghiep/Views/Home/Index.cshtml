@{
    ViewData["Title"] = "Thiệp Mời Tốt Nghiệp - Lễ Quốc Huy";
}

@section Styles {
    <style>
        :root {
            --primary-color: #A67C52;
            --accent-color: #E89528;
            --bg-color: #FFFDF1;
            --card-bg: #FFFFFF;
            --text-color: #333333;
            --info-label-color: #8C8C8C;
        }
    </style>
}

<video id="bg-video-laptop" autoplay muted loop playsinline>
    <source src="~/Video/Ngang_LapTop.mp4" type="video/mp4">
</video>

<video id="bg-video-mobile" autoplay muted loop playsinline>
    <source src="~/Video/Doc_Mobile.mp4" type="video/mp4">
</video>

<button id="chat-btn" title="Chat với chúng tôi" onclick="toggleChat()">
    <i class="bi bi-chat-dots-fill" id="chat-icon"></i>
</button>

<!-- Popup chat -->
<div id="chat-popup" style="display:none;">
    <div id="chat-header">
        <span>Cồng đồng bạn của <b>Quốc Huy</b></span>
        <button onclick="toggleChat()" title="Thu nhỏ">－</button>
    </div>

    <div id="chat-messages">
        <!-- Tin nhắn mẫu -->
        <div class="msg msg-left">Oke fennn để bữa sau tốt nghiệp ae làm tấm nữa kk</div>
        <div class="msg msg-right">Ok kk</div>
        <div class="msg msg-right">Ùa có mấy hình hà ta. Hay nó chưa qua hết</div>
        <div class="msg msg-left">À để t gửi qua hết cho</div>
        <div class="msg msg-right">Ok cảm ơn nhé</div>
    </div>

    <div id="chat-input-area">
        <input type="text" id="chat-input" placeholder="Aa" onkeydown="sendMsg(event)">
        <button onclick="sendMsg()"><i class="bi bi-send-fill"></i></button>
    </div>
</div>

<button id="music-btn" title="Bật/Tắt nhạc nền" onclick="toggleMusic()">
    <i class="bi bi-music-note-beamed" id="music-icon"></i>
</button>

<audio id="bg-music" loop>
    <source src="~/Video/NhacNen.mp3" type="audio/mpeg">
</audio>

<div class="main-container">

    <!-- ===== CAROUSEL ANH KY NIEM ===== -->
    <div class="carousel-section">
        <button class="carousel-btn carousel-btn-prev" onclick="carouselMove(-1)" aria-label="Truoc"><i class="bi bi-chevron-left"></i></button>
        <div class="carousel-track-wrapper">
            <div class="carousel-track" id="carouselTrack">
                <div class="carousel-slide"><img src="~/img/kyNiem/1.jpg" alt="Anh ky niem 1"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/2.jpg" alt="Anh ky niem 2"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/3.jpg" alt="Anh ky niem 3"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/4.jpg" alt="Anh ky niem 4"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/5.jpg" alt="Anh ky niem 5"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/6.jpg" alt="Anh ky niem 6"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/7.jpg" alt="Anh ky niem 7"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/8.jpg" alt="Anh ky niem 8"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/9.jpg" alt="Anh ky niem 9"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/10.jpg" alt="Anh ky niem 10"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/11.jpg" alt="Anh ky niem 11"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/12.jpg" alt="Anh ky niem 12"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/13.jpg" alt="Anh ky niem 13"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/14.jpg" alt="Anh ky niem 14"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/15.jpg" alt="Anh ky niem 15"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/16.jpg" alt="Anh ky niem 16"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/17.jpg" alt="Anh ky niem 17"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/18.jpg" alt="Anh ky niem 18"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/19.jpg" alt="Anh ky niem 19"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/20.jpg" alt="Anh ky niem 20"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/21.jpg" alt="Anh ky niem 21"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/22.jpg" alt="Anh ky niem 22"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/23.jpg" alt="Anh ky niem 23"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/24.jpg" alt="Anh ky niem 24"></div>
                <div class="carousel-slide"><img src="~/img/kyNiem/25.jpg" alt="Anh ky niem 25"></div>
            </div>
        </div>
        <button class="carousel-btn carousel-btn-next" onclick="carouselMove(1)" aria-label="Tiep"><i class="bi bi-chevron-right"></i></button>
        <div class="carousel-dots" id="carouselDots"></div>
    </div>

    <div class="header-section">
        <p class="welcome-text">Chào mừng</p>
        <p id="welcomeTextName" class="guest-name-header">Quý khách</p>

        <div class="graduation-title-box">
            <h1 class="graduation-title">Lễ Tốt Nghiệp</h1>
            <p class="graduation-year">NIÊN KHÓA 2026</p>
        </div>
    </div>

    <div class="content-grid">
        <div class="image-card">
            <div class="guest-image-container">
                <img id="guestImage" src="~/images/default-grad.jpg" alt="Ảnh Tốt Nghiệp" class="guest-image" />

                <div class="corner-bl"></div>
                <div class="corner-br"></div>
            </div>
        </div>
        <div class="info-card">
            <div class="info-item">
                <div class="info-icon"><i class="bi bi-person"></i></div>
                <div class="info-text-group">
                    <span class="info-label">Người tốt nghiệp:</span>
                    <span class="info-value">LÊ QUỐC HUY</span>
                </div>
            </div>

            <div class="info-item">
                <div class="info-icon"><i class="bi bi-mortarboard"></i></div>
                <div class="info-text-group">
                    <span class="info-label">Chuyên ngành:</span>
                    <span class="info-value">HỆ THỐNG THÔNG TIN QUẢN LÝ</span>
                </div>
            </div>

            <div class="info-item">
                <div class="info-icon"><i class="bi bi-clock"></i></div>
                <div class="info-text-group">
                    <span class="info-label">Thời gian:</span>
                    <span class="info-value">15:30 - 17:00 24/05/2026</span>
                </div>
            </div>

            <div class="info-item">
                <div class="info-icon"><i class="bi bi-phone"></i></div>
                <div class="info-text-group">
                    <span class="info-label">Điện thoại tôi:</span>
                    <span class="info-value">0779536903 - 0334112907</span>
                </div>
            </div>

            <div class="info-item">
                <div class="info-icon"><i class="bi bi-geo-alt"></i></div>
                <div class="info-text-group">
                    <span class="info-label">Địa điểm:</span>
                    <span class="info-value">Giảng đường chính</span>
                    <span class="info-value-sub">Trường đại học Ngân hàng TPHCM</span>
                </div>
            </div>

            <div class="info-item">
                <div class="info-icon"><i class="bi bi-map"></i></div>
                <div class="info-text-group">
                    <span class="info-label">Địa chỉ:</span>
                    <span class="info-value">56 Hoàng Diệu 2, Phường Thủ Đức</span>
                    <span class="info-value-sub">TP. Hồ Chí Minh</span>
                </div>
            </div>

            <div class="parking-section">
                <p class="parking-title">Vị trí bãi giữ xe máy:</p>

                <div class="dropdown">
                    <div class="dropdown-btn">Chọn vị trí</div>

                    <ul class="dropdown-list">
                        <li data-value="gate16"><b>Cổng 16 (Ưu tiên 1):</b> 32A Đ. Số 16, Linh Chiểu, Thủ Đức, Hồ Chí Minh, Việt Nam</li>
                        <li data-value="gate17"><b>Cổng 17 (Ưu tiên 2):</b> VQ46+CGF, Linh Chiểu, Thủ Đức, Hồ Chí Minh, Việt Nam</li>
                    </ul>
                </div>
            </div>

            <div class="participation-notice">
                <p class="participation-text-top">Rất mong sự tham gia của</p>
                <p id="participationTextName" class="guest-name-participation">Quý khách</p>
                <p class="participation-text-top">Sẽ có 1 album tốt nghiệp, mình mong sẽ có ảnh của mình và bạn trong đó! Nhớ quay lại website sau tốt nghiệp của mình nhé.</p>
            </div>

            <div class="d-flex justify-content-center gap-2 mt-3">
                <button id="btnPrint" class="btn btn-warning w-100" onclick="printInvitation()">
                    <i class="bi bi-printer"></i> In Thiệp
                </button>
                <button id="btnAlbum" class="btn btn-success w-50 d-none">
                    <i class="bi bi-images"></i> Album
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="nameModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="nameModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="nameModalLabel">Nhập Tên Khách Mời</h5>
            </div>
            <div class="modal-body">
                <div class="text-center mb-1">Vui lòng nhập chính xác họ và tên giúp mình nhé!</div>
                <input type="text" id="guestNameInput" class="form-control" placeholder="Ví dụ: Lê Quốc Huy" />
                <div id="nameError" class="text-danger mt-2" style="display: none;">Vui lòng nhập tên!</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="submitName()">Xác Nhận</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="attendanceModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="attendanceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="attendanceModalLabel">Xác Nhận Tham Gia</h5>
            </div>
            <div class="modal-body">
                Bạn có tham gia lễ tốt nghiệp cùng chúng tôi không?
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-success" onclick="submitAttendance(true)">Có, tôi sẽ tham gia</button>
                <button type="button" class="btn btn-secondary" onclick="submitAttendance(false)">Không, tôi bận</button>
            </div>
        </div>
    </div>
</div>

<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="liveToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                Hãy bấm in thiệp ở bên dưới!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        let currentGuestId = 0;
        let currentGuestName = "";
        let nameModal;
        let attendanceModal;
    </script>
}